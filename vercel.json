{
  "cleanUrls": true,
  "functions": {
    "api/expense-scan.js": { "maxDuration": 60 },
    "api/expenses.js": { "maxDuration": 30 },
    "api/invoices.js": { "maxDuration": 30, "includeFiles": "api/_fonts/**" }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/((?!app$).*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self'; object-src 'none'; base-uri 'self'" }
      ]
    },
    {
      "source": "/app",
      "headers": [
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self' https://web.telegram.org; object-src 'none'; base-uri 'self'" }
      ]
    }
  ]
}
