# Образец. Настоящие значения вписываются ТОЛЬКО в Vercel: Settings → Environment Variables.
# Сюда ничего секретного не писать.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ADMIN_PASSWORD=
SESSION_SECRET=
GEMINI_API_KEY=
# Токен MCP-сервера /api/mcp (длинная случайная строка). Тот же токен — в настройке MCP у Claude Code.
MCP_TOKEN=
# Голосовой агент (блок 4). VOICE_SECRET — длинная случайная строка, та же в Vercel и в сейфе ElevenLabs.
VOICE_SECRET=
# Ключ ElevenLabs нужен только локально для scripts/voice-agent.mjs, в Vercel его не добавлять.
ELEVENLABS_API_KEY=
